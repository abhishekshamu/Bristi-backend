{
  "name": "bristi-backend",
  "version": "1.0.0",
  "description": "BRISTI - Premium Luxury Clothing Brand E-commerce Backend API",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "lint": "eslint src --ext .ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed-content": "tsx src/scripts/seed-content.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:repair-inventory": "tsx src/scripts/repair-inventory.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.10",
    "razorpay": "^2.9.2",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.4",
    "stripe": "^14.16.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^8.56.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.7.0",
    "typescript": "~5.9.3"
  }
}
