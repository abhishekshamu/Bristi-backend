# BRISTI Backend - local development configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_RATE_LIMIT=300

# Paste your MongoDB Atlas connection string here, e.g.:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bristi?retryWrites=true&w=majority
# Leave empty to use the in-memory MongoDB dev fallback.
MONGODB_URI=mongodb+srv://bristi:bristi12345@splitbuddy.zbtl7zo.mongodb.net/bristi?retryWrites=true&w=majority&appName=splitbuddy

JWT_SECRET=development-only-access-secret-change-me
JWT_REFRESH_SECRET=development-only-refresh-secret-change-me
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
JWT_REFRESH_TOKEN_DAYS=30

EMAIL_FROM=BRISTI <no-reply@bristi.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
API_RATE_LIMIT_DEV=10000
