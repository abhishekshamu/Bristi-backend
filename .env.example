# ============================================
# BRISTI Backend Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================

# ---- Backend ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (storefront/admin/custom
# domains). This is the canonical CORS allow-list in production, e.g.:
# ALLOWED_ORIGINS=https://bristi-frontend.vercel.app,https://bristi-admin.vercel.app
# The production domains bristi-frontend.vercel.app and bristi-admin.vercel.app
# are always allowed by default. Local dev origins (localhost:3000-3005,
# 5173/4173) are always allowed. No wildcard is used — credentials/cookies are
# cross-site, so CORS must stay explicit.
# FRONTEND_URL= (legacy alias, same format — still supported)
ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:3000
# Cookie SameSite policy. Use none when storefront and API are on different
# sites (e.g. storefront on Vercel, API on Render) so auth/cart cookies are
# sent cross-site. Requires NODE_ENV=production for Secure. When none, the
# Partitioned (CHIPS) attribute is added automatically so modern browsers that
# block third-party cookies still store the session.
# COOKIE_SAME_SITE=none
# Public URL of this API. When set, media URLs are stored/returned as absolute
# URLs under it; when empty, relative /uploads/ URLs are stored instead.
# API_URL=https://bristi-backend.onrender.com
API_RATE_LIMIT=300

# ---- MongoDB ----
# Use your MongoDB Atlas connection string:
# e.g. mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bristi?retryWrites=true&w=majority
# If this is left empty, the server falls back to an in-memory MongoDB (development only).
MONGODB_URI=

# ---- JWT ----
JWT_SECRET=development-only-access-secret-change-me
JWT_REFRESH_SECRET=development-only-refresh-secret-change-me
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
JWT_REFRESH_TOKEN_DAYS=30

# ---- Google OAuth (Google sign-in) ----
# Client ID/Secret from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SMS / OTP ----
# Preferred provider (Twilio):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Generic HTTP provider (alternative to Twilio):
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=BRISTI

# ---- Email (SMTP) ----
EMAIL_FROM=BRISTI <no-reply@bristi.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Media (Cloudinary) ----
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
